import streamlit as st
import requests
import pandas as pd
from datetime import datetime, timedelta
import plotly.graph_objects as go
import plotly.express as px
from textblob import TextBlob
import os
from dotenv import load_dotenv
from groq import Groq
import json

# Load environment variables
load_dotenv()

# API Configuration
POLYGON_API_KEY = os.getenv('POLYGON_API_KEY')
NEWS_API_KEY = os.getenv('NEWS_API_KEY')
GROQ_API_KEY = os.getenv('GROQ_API_KEY')

# Initialize Groq client
try:
    groq_client = Groq(api_key=GROQ_API_KEY)
except:
    groq_client = None

def get_stock_data(symbol, days=30):
    """Fetch stock data from Polygon API"""
    try:
        end_date = datetime.now().strftime('%Y-%m-%d')
        start_date = (datetime.now() - timedelta(days=days)).strftime('%Y-%m-%d')
        
        url = f"https://api.polygon.io/v2/aggs/ticker/{symbol}/range/1/day/{start_date}/{end_date}"
        params = {'apikey': POLYGON_API_KEY}
        
        response = requests.get(url, params=params)
        data = response.json()
        
        if 'results' in data:
            df = pd.DataFrame(data['results'])
            df['date'] = pd.to_datetime(df['t'], unit='ms')
            df = df.rename(columns={
                'o': 'open', 'h': 'high', 'l': 'low', 'c': 'close', 'v': 'volume'
            })
            return df[['date', 'open', 'high', 'low', 'close', 'volume']]
        return None
    except Exception as e:
        st.error(f"Error fetching stock data: {e}")
        return None

def get_news_data(symbol, days=7):
    """Fetch news data from News API"""
    try:
        end_date = datetime.now()
        start_date = end_date - timedelta(days=days)
        
        # Get company name for better search results
        company_names = {
            'AAPL': 'Apple Inc',
            'GOOGL': 'Google Alphabet',
            'MSFT': 'Microsoft',
            'TSLA': 'Tesla',
            'AMZN': 'Amazon',
            'META': 'Meta Facebook',
            'NVDA': 'NVIDIA'
        }
        
        search_query = company_names.get(symbol, symbol)
        
        url = "https://newsapi.org/v2/everything"
        params = {
            'q': search_query,
            'from': start_date.strftime('%Y-%m-%d'),
            'to': end_date.strftime('%Y-%m-%d'),
            'sortBy': 'publishedAt',
            'language': 'en',
            'apiKey': NEWS_API_KEY,
            'pageSize': 20
        }
        
        response = requests.get(url, params=params)
        data = response.json()
        
        if 'articles' in data:
            articles = []
            for article in data['articles']:
                if article['title'] and article['description']:
                    articles.append({
                        'title': article['title'],
                        'description': article['description'],
                        'url': article['url'],
                        'publishedAt': article['publishedAt'],
                        'source': article['source']['name']
                    })
            return articles
        return []
    except Exception as e:
        st.error(f"Error fetching news data: {e}")
        return []

def analyze_sentiment(text):
    """Analyze sentiment using TextBlob"""
    try:
        blob = TextBlob(text)
        polarity = blob.sentiment.polarity
        
        if polarity > 0.1:
            return 'Positive', polarity
        elif polarity < -0.1:
            return 'Negative', polarity
        else:
            return 'Neutral', polarity
    except:
        return 'Neutral', 0.0

def get_groq_analysis(stock_data, news_sentiment, symbol):
    """Get AI analysis from Groq"""
    if not groq_client:
        return "Groq API not available. Please check your API key."
    
    try:
        # Prepare data for Groq
        latest_price = stock_data['close'].iloc[-1] if not stock_data.empty else 0
        price_change = ((latest_price - stock_data['close'].iloc[0]) / stock_data['close'].iloc[0] * 100) if len(stock_data) > 1 else 0
        
        avg_sentiment = sum([s['sentiment_score'] for s in news_sentiment]) / len(news_sentiment) if news_sentiment else 0
        positive_news = len([s for s in news_sentiment if s['sentiment'] == 'Positive'])
        negative_news = len([s for s in news_sentiment if s['sentiment'] == 'Negative'])
        
        prompt = f"""
        Analyze the stock {symbol} based on the following data:
        
        Stock Performance:
        - Current Price: ${latest_price:.2f}
        - Price Change (30 days): {price_change:.2f}%
        - Trading Volume: {stock_data['volume'].mean():.0f} (average)
        
        News Sentiment Analysis:
        - Average Sentiment Score: {avg_sentiment:.3f} (range: -1 to 1)
        - Positive News Articles: {positive_news}
        - Negative News Articles: {negative_news}
        - Total Articles Analyzed: {len(news_sentiment)}
        
        Please provide:
        1. A brief market outlook for this stock
        2. Key factors influencing the stock based on news sentiment
        3. Potential risks and opportunities
        4. A recommendation (Hold/Buy/Sell) with reasoning
        
        Keep the analysis concise and professional.
        """
        
        chat_completion = groq_client.chat.completions.create(
            messages=[
                {
                    "role": "user",
                    "content": prompt
                }
            ],
            model="llama3-8b-8192",
            temperature=0.3,
            max_tokens=500
        )
        
        return chat_completion.choices[0].message.content
    except Exception as e:
        return f"Error getting Groq analysis: {e}"

def main():
    st.set_page_config(
        page_title="Stock Sentiment Analysis Dashboard",
        page_icon="📈",
        layout="wide"
    )
    
    st.title("📈 Stock Sentiment Analysis Dashboard")
    st.markdown("Analyze stocks using market data, news sentiment, and AI insights")
    
    # Sidebar for configuration
    st.sidebar.header("Configuration")
    
    # Stock symbol input
    symbol = st.sidebar.text_input("Stock Symbol", value="AAPL", help="Enter stock ticker (e.g., AAPL, GOOGL)")
    
    # Time range selection
    days_stock = st.sidebar.slider("Stock Data Range (days)", 7, 90, 30)
    days_news = st.sidebar.slider("News Data Range (days)", 1, 14, 7)
    
    # Check API keys
    if not all([POLYGON_API_KEY, NEWS_API_KEY, GROQ_API_KEY]):
        st.error("⚠️ Please ensure all API keys are set in your .env file")
        st.info("Required: POLYGON_API_KEY, NEWS_API_KEY, GROQ_API_KEY")
        return
    
    if st.sidebar.button("Analyze Stock", type="primary"):
        with st.spinner(f"Analyzing {symbol.upper()}..."):
            
            # Fetch stock data
            st.subheader(f"📊 Stock Data for {symbol.upper()}")
            stock_data = get_stock_data(symbol.upper(), days_stock)
            
            if stock_data is not None and not stock_data.empty:
                # Display stock chart
                fig = go.Figure(data=go.Candlestick(
                    x=stock_data['date'],
                    open=stock_data['open'],
                    high=stock_data['high'],
                    low=stock_data['low'],
                    close=stock_data['close']
                ))
                fig.update_layout(
                    title=f"{symbol.upper()} Stock Price",
                    xaxis_title="Date",
                    yaxis_title="Price ($)",
                    height=400
                )
                st.plotly_chart(fig, use_container_width=True)
                
                # Display key metrics
                col1, col2, col3, col4 = st.columns(4)
                latest_price = stock_data['close'].iloc[-1]
                price_change = latest_price - stock_data['close'].iloc[0]
                price_change_pct = (price_change / stock_data['close'].iloc[0]) * 100
                
                with col1:
                    st.metric("Current Price", f"${latest_price:.2f}")
                with col2:
                    st.metric("Price Change", f"${price_change:.2f}", f"{price_change_pct:.2f}%")
                with col3:
                    st.metric("Volume", f"{stock_data['volume'].iloc[-1]:,.0f}")
                with col4:
                    st.metric("High", f"${stock_data['high'].max():.2f}")
            else:
                st.error("Unable to fetch stock data. Please check the symbol and try again.")
                return
            
            # Fetch and analyze news
            st.subheader("📰 News Sentiment Analysis")
            news_articles = get_news_data(symbol.upper(), days_news)
            
            if news_articles:
                # Analyze sentiment for each article
                news_with_sentiment = []
                for article in news_articles:
                    text = f"{article['title']} {article['description']}"
                    sentiment, score = analyze_sentiment(text)
                    news_with_sentiment.append({
                        **article,
                        'sentiment': sentiment,
                        'sentiment_score': score
                    })
                
                # Display sentiment summary
                sentiment_counts = pd.DataFrame(news_with_sentiment)['sentiment'].value_counts()
                
                col1, col2 = st.columns(2)
                
                with col1:
                    # Sentiment pie chart
                    fig_pie = px.pie(
                        values=sentiment_counts.values,
                        names=sentiment_counts.index,
                        title="News Sentiment Distribution",
                        color_discrete_map={
                            'Positive': '#00CC96',
                            'Negative': '#EF553B',
                            'Neutral': '#FFA15A'
                        }
                    )
                    st.plotly_chart(fig_pie, use_container_width=True)
                
                with col2:
                    # Sentiment metrics
                    avg_sentiment = sum([article['sentiment_score'] for article in news_with_sentiment]) / len(news_with_sentiment)
                    positive_count = len([a for a in news_with_sentiment if a['sentiment'] == 'Positive'])
                    negative_count = len([a for a in news_with_sentiment if a['sentiment'] == 'Negative'])
                    
                    st.metric("Average Sentiment", f"{avg_sentiment:.3f}")
                    st.metric("Positive Articles", positive_count)
                    st.metric("Negative Articles", negative_count)
                
                # Display recent news
                st.subheader("Recent News Articles")
                for i, article in enumerate(news_with_sentiment[:5]):
                    sentiment_color = {
                        'Positive': '🟢',
                        'Negative': '🔴',
                        'Neutral': '🟡'
                    }
                    
                    with st.expander(f"{sentiment_color[article['sentiment']]} {article['title'][:100]}..."):
                        st.write(f"**Source:** {article['source']}")
                        st.write(f"**Published:** {article['publishedAt']}")
                        st.write(f"**Sentiment:** {article['sentiment']} ({article['sentiment_score']:.3f})")
                        st.write(f"**Description:** {article['description']}")
                        st.write(f"**URL:** {article['url']}")
                
                # Get Groq AI analysis
                st.subheader("🤖 AI Analysis")
                with st.spinner("Getting AI insights..."):
                    ai_analysis = get_groq_analysis(stock_data, news_with_sentiment, symbol.upper())
                    st.markdown(ai_analysis)
            
            else:
                st.warning("No recent news articles found for this stock.")

if __name__ == "__main__":
    main()